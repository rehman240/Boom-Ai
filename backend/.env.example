# Copy to backend/.env for local development. Never commit real values.

# --- App ---
APP_ENV=development
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database (plain Postgres) ---
DATABASE_URL=postgresql+psycopg://boooom:boooom@localhost:5432/boooom_more

# --- File storage ---
# local = backend/uploads/ (development only, lost on redeploy)
# s3    = any S3 compatible bucket: Supabase Storage now, AWS S3 later.
#         Keep the bucket private; files are served through the API to their owner.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Per file. Allowed types are PNG, JPEG, WebP and PDF; SVG is refused.
UPLOAD_MAX_MB=5

# --- AI provider (all calls go through the adapter) ---
# AI_ENABLED=false pauses all generation
AI_ENABLED=true
# anthropic | openai | mock
AI_PROVIDER=mock
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
