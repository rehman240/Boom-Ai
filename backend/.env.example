# Copy to backend/.env for local development. Never commit real values.

# --- App ---
APP_ENV=development
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Database (plain Postgres) ---
DATABASE_URL=postgresql+psycopg://boooom:boooom@localhost:5432/boooom_more

# --- File storage (S3 compatible, e.g. Supabase Storage) ---
# STORAGE_BACKEND=local uses backend/uploads/ for development
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_MB=5

# --- AI provider (all calls go through the adapter) ---
# AI_ENABLED=false pauses all generation
AI_ENABLED=true
# anthropic | openai | mock
AI_PROVIDER=mock
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
